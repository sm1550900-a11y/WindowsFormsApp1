<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ParkingMauiApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ParkingMauiApp.Views"
    Title="Parking MAUI">

    <ShellContent Route="welcome" ContentTemplate="{DataTemplate views:WelcomePage}" />
    <ShellContent Route="auth" ContentTemplate="{DataTemplate views:AuthPage}" />
    <TabBar Route="main">
        <ShellContent Title="Главная" ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent Title="История" ContentTemplate="{DataTemplate views:BookingHistoryPage}" />
        <ShellContent Title="Профиль" ContentTemplate="{DataTemplate views:ProfilePage}" />
        <ShellContent Title="Настройки" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>
</Shell>
