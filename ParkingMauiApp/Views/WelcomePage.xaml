<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingMauiApp.Views.WelcomePage"
             Title="Приветствие">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="🚗 Parking App" FontSize="32" HorizontalOptions="Center" />
        <Label Text="Добро пожаловать! Найдите и забронируйте парковку за пару кликов." HorizontalTextAlignment="Center" />

        <Button Text="Войти" Command="{Binding GoToLoginCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" />
        <Button Text="Регистрация" Command="{Binding GoToRegisterCommand}" />

        <Label Text="• Поиск свободных мест&#10;• Бронирование&#10;• Управление профилем" />
    </VerticalStackLayout>
</ContentPage>
