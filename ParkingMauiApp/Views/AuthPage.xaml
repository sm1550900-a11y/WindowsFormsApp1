<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingMauiApp.Views.AuthPage"
             Title="Регистрация и вход">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10">
            <Entry Placeholder="Имя" Text="{Binding Name}" />
            <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
            <Entry Placeholder="Пароль" IsPassword="True" Text="{Binding Password}" />
            <Entry Placeholder="Подтвердите пароль" IsPassword="True" Text="{Binding ConfirmPassword}" />
            <Button Text="Зарегистрироваться" Command="{Binding RegisterCommand}" />
            <Button Text="Войти" Command="{Binding LoginCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White"/>
            <Label Text="{Binding Hint}" TextColor="Gray" />
            <Label Text="Забыли пароль?" TextColor="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
