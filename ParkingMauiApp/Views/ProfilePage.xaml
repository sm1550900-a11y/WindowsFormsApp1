<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingMauiApp.Views.ProfilePage"
             Title="Личный кабинет">
    <VerticalStackLayout Padding="24" Spacing="10">
        <Label Text="Личный кабинет" FontSize="24" />
        <Entry Placeholder="Имя" Text="{Binding Name}" />
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
        <Button Text="Сохранить" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" />
    </VerticalStackLayout>
</ContentPage>
