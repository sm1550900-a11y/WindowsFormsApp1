<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ParkingMauiApp.Views.SettingsPage"
             Title="Настройки">
    <VerticalStackLayout Padding="24" Spacing="14">
        <Label Text="Настройки и уведомления" FontSize="24" />
        <HorizontalStackLayout>
            <Label Text="Включить уведомления" VerticalOptions="Center" />
            <Switch IsToggled="{Binding NotificationsEnabled}" />
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Тёмная тема" VerticalOptions="Center" />
            <Switch IsToggled="{Binding DarkThemeEnabled}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
